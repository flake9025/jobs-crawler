# ---- Configuration serveur ----
PORT=8080
# Adresse publique de l'application, utilisée dans les emails d'alerte (bouton « Ouvrir »,
# lien de désinscription). Exemple : https://jobs.mondomaine.fr
PUBLIC_URL=

# ---- API France Travail (ex Pôle Emploi) ----
# Créez une application sur https://francetravail.io/ pour obtenir ces identifiants.
# Souscrivez à l'API "Offres d'emploi v2". Sans ces clés, le connecteur France Travail est désactivé.
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=

# ---- Options de scraping ----
# Activer/désactiver le scraping des agrégateurs (WTTJ, HelloWork, APEC) et le crawl des sites d'entreprises
ENABLE_SCRAPERS=true
# Nombre max de résultats par source
MAX_PER_SOURCE=25
# Timeout réseau (ms)
FETCH_TIMEOUT_MS=12000

# ---- Crawl des sites d'entreprises (worker de fond) ----
# L'annuaire compte ~7 300 entreprises, dont ~1 950 avec un site web crawlé.
# Nombre de sites analysés en parallèle (12 => ~12 min pour un tour complet).
CRAWL_CONCURRENCY=12
# Intervalle entre deux crawls complets (minutes)
CACHE_REFRESH_MINUTES=360
# Relancer un crawl au démarrage si le cache est plus vieux que ça (minutes)
CACHE_STALE_MINUTES=360
# Fichier de persistance des alertes (recherches sauvegardées + abonnements push)
ALERTS_FILE=/app/data/alerts.json
# Intervalle entre deux vérifications des alertes (minutes)
ALERTS_CHECK_MINUTES=30

# ---- Alertes email (nouvelles offres) ----
# Serveur SMTP utilisé pour envoyer les alertes par email. Sans ces variables,
# l'alerting email est désactivé (les alertes push restent possibles).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Sophia Jobs <no-reply@sophia-jobs.local>

# ---- Alertes notifications push navigateur ----
# Générez une paire de clés avec : npm run vapid:generate
# Les navigateurs n'autorisent les notifications que sur un site HTTPS (ou localhost) :
# servie en http://NAS:8082, l'application ne peut pas les proposer. Exposez-la en HTTPS
# (ex. proxy inversé DSM + certificat Let's Encrypt) et renseignez PUBLIC_URL.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=contact@sophia-jobs.local
